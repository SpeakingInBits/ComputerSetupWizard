<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ComputerSetupWizard.Pages.BotKeyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="900" Padding="32,24" Spacing="12">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Bot private key" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                Each machine gets its own private key for the SpeakingInBits-Bot app, so one machine can be
                revoked without breaking the others. The key lives in C:\Dev and never goes in a repo. When a
                machine is retired, delete its key on the app settings page.
            </TextBlock>

            <InfoBar x:Name="KeyBar" IsClosable="False" IsOpen="True" />

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Get a key for this machine" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                1. Open the app settings and click Generate a private key. Your browser downloads a .pem file.
            </TextBlock>
            <Button Click="OpenSettings_Click" Content="Open app settings" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                2. Move the key from your Downloads folder to C:\Dev. If it isn't in Downloads, you can pick it.
            </TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="ImportButton"
                    Click="Import_Click"
                    Content="Import downloaded key" />
                <TextBlock x:Name="ImportStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Check the bot" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                Gets a token with the key and shows what the bot can do. The token itself is never shown.
            </TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="CheckButton"
                    Click="Check_Click"
                    Content="Check"
                    Style="{StaticResource AccentButtonStyle}" />
                <ProgressRing x:Name="CheckProgress" Width="20" Height="20" IsActive="False" />
            </StackPanel>
            <TextBlock
                x:Name="InfoText"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>

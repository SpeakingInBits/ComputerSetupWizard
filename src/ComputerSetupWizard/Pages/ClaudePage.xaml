<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ComputerSetupWizard.Pages.ClaudePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ComputerSetupWizard.Controls"
    xmlns:local="using:ComputerSetupWizard.Pages">

    <ScrollViewer>
        <StackPanel MaxWidth="900" Padding="32,24" Spacing="12">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Set up Claude Code" />

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Mods" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                Plugins from SpeakingInBits/claude-mods. They're installed for your user, so they run in every
                session: the terminal, the desktop app and VS Code. New mods take effect in the next session,
                or after /reload-plugins.
            </TextBlock>

            <ListView ItemsSource="{x:Bind Mods}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ModItem">
                        <Grid Padding="0,6" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect, Mode=OneWay}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Mod.Name}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Mod.Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="{x:Bind IsBusy, Mode=OneWay}" />
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{x:Bind Brush, Mode=OneWay}"
                                    Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button
                x:Name="InstallModsButton"
                Click="InstallMods_Click"
                Content="Install selected mods"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}" />
            <TextBlock
                x:Name="ModsRoute"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
            <controls:LogView x:Name="ModsLog" Visibility="Collapsed" />

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Bot instructions" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                Adds this section to your personal CLAUDE.md, so every Claude Code session on this machine
                commits and opens pull requests as the bot in SpeakingInBits repos. If the section is already
                there, it's replaced; the rest of the file is kept.
            </TextBlock>

            <InfoBar x:Name="StateBar" IsClosable="False" IsOpen="True" />

            <Border
                Padding="16,12"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <TextBlock
                    x:Name="Preview"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="WriteButton"
                    Click="Write_Click"
                    Style="{StaticResource AccentButtonStyle}" />
                <TextBlock x:Name="WriteStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

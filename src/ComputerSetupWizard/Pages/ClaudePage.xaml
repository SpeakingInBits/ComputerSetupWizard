<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ComputerSetupWizard.Pages.ClaudePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="900" Padding="32,24" Spacing="12">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Tell Claude Code to use the bot" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                Adds this section to your personal CLAUDE.md, so every Claude Code session on this machine
                commits and opens pull requests as the bot in SpeakingInBits repos. If the section is already
                there, it's replaced; the rest of the file is kept.
            </TextBlock>

            <InfoBar x:Name="StateBar" IsClosable="False" IsOpen="True" />

            <Border
                Padding="16,12"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <TextBlock
                    x:Name="Preview"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="WriteButton"
                    Click="Write_Click"
                    Style="{StaticResource AccentButtonStyle}" />
                <TextBlock x:Name="WriteStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

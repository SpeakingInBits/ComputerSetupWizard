<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ComputerSetupWizard.Pages.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ComputerSetupWizard.Controls"
    xmlns:core="using:ComputerSetupWizard.Core"
    xmlns:local="using:ComputerSetupWizard.Pages">

    <ScrollViewer>
        <StackPanel MaxWidth="900" Padding="32,24" Spacing="12">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Back up and restore" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                Saves settings that winget can't install again, so a new PC can pick them up. Back up on the old PC.
                On the new one, install the apps first, then restore. Passwords and other secrets aren't copied.
            </TextBlock>

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Backup folder" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                Choose a folder the new PC can reach, such as one in OneDrive or on a USB drive.
            </TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="FolderButton"
                    Click="ChooseFolder_Click"
                    Content="Choose folder" />
                <TextBlock x:Name="FolderText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="What to save" />
            <ListView ItemsSource="{x:Bind Items}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:BackupRow">
                        <Grid Padding="0,6" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Item.Name}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Item.Description}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Detail, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="{x:Bind IsBusy, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="BackupButton"
                    Click="Backup_Click"
                    Content="Back up selected"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="RestoreButton"
                    Click="Restore_Click"
                    Content="Restore selected" />
            </StackPanel>

            <controls:LogView x:Name="Log" />

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Apps with secrets" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                List the apps that keep a password, API key or other secret on this PC, such as a .env file or a
                signed-in tool, so you remember to move each one with your password manager. The wizard saves only
                the list, never the secrets, and it goes in the backup folder with everything else.
            </TextBlock>
            <ListView ItemsSource="{x:Bind SecretApps}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:SecretApp">
                        <Grid Padding="0,6" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Note}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Click="RemoveSecretApp_Click"
                                Content="Remove" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SecretAppName" PlaceholderText="App, such as AWS CLI" />
                <TextBox
                    x:Name="SecretAppNote"
                    Grid.Column="1"
                    PlaceholderText="Where the secret is (optional), such as ~\.aws\credentials" />
                <Button
                    Grid.Column="2"
                    Click="AddSecretApp_Click"
                    Content="Add" />
            </Grid>
            <TextBlock x:Name="SecretAppsStatus" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>

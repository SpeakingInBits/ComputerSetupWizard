<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ComputerSetupWizard.Pages.BotIdentityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="900" Padding="32,24" Spacing="12">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Use the bot in SpeakingInBits repos" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                One setting in your global Git config makes every repo with a SpeakingInBits remote commit as the
                bot and push with bot tokens from this wizard, including clones you make later. Every other repo
                keeps your personal identity.
            </TextBlock>

            <InfoBar x:Name="StateBar" IsClosable="False" IsOpen="True" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="SetUpButton"
                    Click="SetUp_Click"
                    Content="Use the bot in SpeakingInBits repos"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="RemoveButton"
                    Click="Remove_Click"
                    Content="Back to personal identity" />
            </StackPanel>

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Clones set up the old way" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                Older versions of the wizard put the bot settings in each clone. Those settings override the global
                one, and stop pushes working if they point at a wizard that moved. This removes them from the
                SpeakingInBits clones in the usual folders, and leaves anything else in their config alone.
            </TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="CleanUpButton"
                    Click="CleanUp_Click"
                    Content="Find and clean up" />
                <ProgressRing x:Name="CleanUpProgress" Width="20" Height="20" IsActive="False" />
            </StackPanel>
            <TextBlock
                x:Name="CleanUpStatus"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="InstallNote"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ComputerSetupWizard.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ComputerSetupWizard.Controls"
    xmlns:local="using:ComputerSetupWizard.Pages">

    <ScrollViewer>
        <StackPanel MaxWidth="900" Padding="32,24" Spacing="12">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Install tools" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                Installs with winget. Git and the GitHub CLI are needed for the rest of the setup.
                Installing accepts each package's license, and Windows may ask for administrator approval.
            </TextBlock>

            <InfoBar
                x:Name="WingetMissing"
                IsClosable="False"
                Message="winget wasn't found. Install or update App Installer from the Microsoft Store, then come back."
                Severity="Error" />

            <ListView ItemsSource="{x:Bind Packages}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PackageItem">
                        <Grid Padding="0,6" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect, Mode=OneWay}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Package.Name}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Package.Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="{x:Bind IsBusy, Mode=OneWay}" />
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{x:Bind Brush, Mode=OneWay}"
                                    Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="InstallButton"
                    Click="Install_Click"
                    Content="Install selected"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="RefreshButton"
                    Click="Refresh_Click"
                    Content="Check again" />
            </StackPanel>

            <controls:LogView x:Name="Log" />
        </StackPanel>
    </ScrollViewer>
</Page>
